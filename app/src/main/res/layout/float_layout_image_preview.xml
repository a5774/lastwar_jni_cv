<?xml version="1.0" encoding="utf-8"?>
<com.example.supercell.FloatLayoutTerminal xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="0dp"
    android:background="@color/purple_200"
    android:orientation="horizontal"
    android:paddingTop="20dp">

    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/float_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/frame_view_description"
        android:background="@color/transparent"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
     />
</com.example.supercell.FloatLayoutTerminal>

