<?xml version="1.0" encoding="utf-8"?>
<com.example.supercell.FloatLayoutTerminal xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:flexbox="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="200dp"
    android:layout_margin="0dp"
    android:background="@color/float_frame_layout"
    android:orientation="vertical"
    android:padding="0dp">

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:baselineAligned="false"
        flexbox:alignContent="center"
        flexbox:alignItems="center"
        flexbox:flexDirection="row_reverse"
        flexbox:justifyContent="space_around">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/float_exit_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="0dp"
            android:backgroundTint="@color/float_frame_layout"
            android:includeFontPadding="false"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/float_drag_exit"
            android:textColor="@color/float_text_color"
            android:textSize="12sp"
            flexbox:layout_flexBasisPercent="10%"
            flexbox:layout_flexGrow="1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/float_drag_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:background="@color/float_drag_view"
            android:gravity="center"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:text="@string/float_drag_tips"
            android:textColor="@color/float_text_color"
            android:textSize="11sp"
            flexbox:layout_flexBasisPercent="70%"
            flexbox:layout_flexGrow="1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/float_function_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:background="@color/float_area_view"
            android:gravity="center"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:text="@string/float_area_vice"
            android:textColor="@color/white"
            android:textSize="12sp"
            flexbox:layout_flexBasisPercent="20%"
            flexbox:layout_flexGrow="1" />
    </com.google.android.flexbox.FlexboxLayout>



    <ScrollView
        android:id="@+id/float_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.example.supercell.FloatViewTerminal
            android:id="@+id/float_scroll_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:padding="0dp"
            android:textColor="@color/float_text_color"
            android:textSize="11sp" />
    </ScrollView>
</com.example.supercell.FloatLayoutTerminal>
