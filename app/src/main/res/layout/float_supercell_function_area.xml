<?xml version="1.0" encoding="utf-8"?>
<com.google.android.flexbox.FlexboxLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:flexbox="http://schemas.android.com/apk/res-auto"
    android:id="@+id/float_flex_beach_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|start"
    android:layout_marginStart="0dp"
    android:layout_marginTop="0dp"
    android:background="@color/float_frame_layout"
    android:padding="0dp"
    flexbox:alignContent="center"
    flexbox:alignItems="center"
    flexbox:flexDirection="row"
    flexbox:flexWrap="wrap"
    flexbox:justifyContent="space_between">

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/float_switch_beach_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:checked="false"
        android:text="@string/float_switch_block_tips"
        android:textColor="@color/float_text_color"
        android:textSize="12sp"
        flexbox:layout_flexBasisPercent="49%"
        flexbox:layout_flexGrow="1" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/float_switch_beach_reboot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:checked="false"
        android:text="@string/float_switch_reboot_tips"
        android:textColor="@color/float_text_color"
        android:textSize="12sp"
        flexbox:layout_flexBasisPercent="50%"
        flexbox:layout_flexGrow="1" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/float_switch_clans_loop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:checked="false"
        android:text="@string/float_switch_night_tips"
        android:textColor="@color/float_text_color"
        android:textSize="12sp"
        flexbox:layout_flexBasisPercent="49%"
        flexbox:layout_flexGrow="1" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/float_switch_beach_loop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:checked="false"
        android:text="@string/float_switch_engraving_tips"
        android:textColor="@color/float_text_color"
        android:textSize="12sp"
        flexbox:layout_flexBasisPercent="50%"
        flexbox:layout_flexGrow="1" />
</com.google.android.flexbox.FlexboxLayout>

